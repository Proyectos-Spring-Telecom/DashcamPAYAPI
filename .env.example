DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dashcam
DB_PASSWORD=
DB_DATABASE=DashCamDev
# TLS a MySQL. false mantiene la conexión actual. true exige certificado válido.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES=7d
JWT_PURPOSE_SECRET=change-me-purpose
JWT_CONFIRMACION=15m

RECARGA_MONTO_MAX=10000
# El login del operador reasigna el validador del camión en el que entra.
# Esta variable ya no impide esa reasignación.
ENFORCE_PIN_BINDING=true
ENFORCE_CVV2_FORBIDDEN=true
ENFORCE_VERIFY_USERNAME=true
ENFORCE_IDEMPOTENCY_KEY=true
ENFORCE_CASH_RECHARGE_ROLES=true
ENFORCE_ROLES_DENY_DEFAULT=true

AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
UPLOAD_MAX_SIZE=10485760

HOST=
SMTP=465
E_MAIL=
SMTP_PASSWORD=

NETPAY_ENVIRONMENT=sandbox
NETPAY_BASE_URL=
NETPAY_PUBLIC_KEY=
NETPAY_PRIVATE_KEY=

FRONTEND_BASE_URL=https://dashcampay.com/dev
CORS_ORIGINS=https://dashcampay.com,http://localhost:4200
CLIENTES_HIERARCHY_TTL_MS=60000
ENFORCE_HTTPS=false
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=

MAX_LOGIN_ATTEMPTS=10
LOCKOUT_MINUTES=30
OTP_MAX_ATTEMPTS=5
# Pepper del HMAC de OTP (>= 32 chars). Cambiarlo invalida los códigos vigentes.
OTP_PEPPER=
BITACORA_HMAC_SECRET=change-me-hmac

# DATETIME naive de MySQL (México). 0 si la BD ya guarda hora local del servidor.
DB_TIME_OFFSET_HOURS=-6
# Cierre automático de tarifas ABIERTAS. 0 desactiva el barrido.
ABIERTA_TTL_HOURS=4
ABIERTA_SWEEP_MINUTES=15
