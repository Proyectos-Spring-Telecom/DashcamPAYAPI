DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dashcam
DB_PASSWORD=
DB_DATABASE=DashCamDev
# TLS a MySQL. false mantiene la conexión actual. true exige certificado válido.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Tamaño del pool de conexiones (H-54). Dimensionar según carga.
DB_POOL_LIMIT=10
# Umbral en ms para loguear queries lentas (H-54).
DB_SLOW_QUERY_MS=2000

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES=7d
JWT_PURPOSE_SECRET=change-me-purpose
JWT_CONFIRMACION=15m

RECARGA_MONTO_MAX=10000
# El login del operador reasigna el validador del camión en el que entra.
# Esta variable ya no impide esa reasignación.
ENFORCE_PIN_BINDING=true
ENFORCE_CVV2_FORBIDDEN=true
ENFORCE_VERIFY_USERNAME=true
ENFORCE_IDEMPOTENCY_KEY=true
ENFORCE_CASH_RECHARGE_ROLES=true
ENFORCE_ROLES_DENY_DEFAULT=true

AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
UPLOAD_MAX_SIZE=10485760

HOST=
SMTP=465
E_MAIL=
SMTP_PASSWORD=

NETPAY_ENVIRONMENT=sandbox
NETPAY_BASE_URL=
NETPAY_PUBLIC_KEY=
NETPAY_PRIVATE_KEY=

FRONTEND_BASE_URL=https://dashcampay.com/dev
CORS_ORIGINS=https://dashcampay.com,http://localhost:4200
CLIENTES_HIERARCHY_TTL_MS=60000
ENFORCE_HTTPS=false
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=

MAX_LOGIN_ATTEMPTS=10
# Intentos fallidos de PIN (login operador) antes del bloqueo temporal (H-40).
MAX_PIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
OTP_MAX_ATTEMPTS=5
# Saltos de proxy de confianza para X-Forwarded-For (H-50). Normalmente 1.
TRUST_PROXY_HOPS=1
# Pepper del HMAC de OTP (>= 32 chars). Cambiarlo invalida los códigos vigentes.
OTP_PEPPER=
BITACORA_HMAC_SECRET=change-me-hmac

# DATETIME naive de MySQL (México). 0 si la BD ya guarda hora local del servidor.
DB_TIME_OFFSET_HOURS=-6
# Cierre automático de tarifas ABIERTAS. 0 desactiva el barrido.
ABIERTA_TTL_HOURS=4
ABIERTA_SWEEP_MINUTES=15

# --- Continuidad y escalado (remediación completa) ---
# Idempotencia de débito: 'false' = ventana de transición (acepta sin clave y
# alerta); 'true' = rechaza el débito sin claveIdempotencia.
ENFORCE_IDEMPOTENCY_KEY=false
# Minutos para considerar vencida una reserva de recarga EN_PROCESO.
RESERVA_STALE_MINUTES=15
# Job de conciliación NetPay (cada 5 min). 'false' lo desactiva.
CONCILIACION_ENABLED=true
# Redis para escalar Socket.IO entre instancias. Vacío = en memoria (1 instancia).
REDIS_URL=
# Retención/purga (días). 0 desactiva cada ventana.
RETENCION_POSICIONES_DIAS=0
RETENCION_BITACORA_DIAS=0
RETENCION_REFRESH_DIAS=0
RETENCION_OTP_DIAS=0
